		"edge": "browser=edge webpack",
		"firefox": "browser=firefox webpack",
		"clean": "rm -rf ./dist && rm -rf ./build",
		"test": "node --experimental-vm-modules ./node_modules/.bin/jest",
		"build": "npm run clean && npm run chrome"
	},
